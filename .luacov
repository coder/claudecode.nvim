local function escape(path)
  return (path:gsub("%p", "%%%0"))
end

local function first_line_of(command)
  local pipe = assert(io.popen(command))
  local line = assert(pipe:read("*l"), command .. " printed nothing")
  pipe:close()
  return line
end

local function temp_folder()
  local folder = (os.getenv("TMPDIR") or ""):gsub("/+$", "")
  return folder == "" and "/tmp" or folder
end

-- luacov matches these Lua patterns against the file's path without the `.lua`.
local include = { "^lua/claudecode/", "^plugin/" }
local folder_as_typed = first_line_of("pwd")
local folder_without_symlinks = first_line_of("pwd -P")
for _, folder in ipairs({ folder_as_typed, folder_without_symlinks }) do
  table.insert(include, "^" .. escape(folder) .. "/lua/claudecode/")
  table.insert(include, "^" .. escape(folder) .. "/plugin/")
end

return {
  statsfile = "luacov.stats.out",
  reportfile = "luacov.report.out",
  include = include,

  -- luacov adds each `modules` pattern to `include`, so a copy of init.lua that a spec runs from a temp folder would
  -- count as hits on lua/claudecode/init.lua.
  exclude = { "^" .. escape(temp_folder()) .. "/claudecode%.%w%w%w%w%w%w/" },

  -- A spec that puts `./lua/?.lua` first on package.path loads a module under a relative name, so the stats hold one
  -- module twice. These names make the report merge the two and list each file by its relative path.
  modules = {
    ["claudecode.*"] = "lua",
    ["claudecode.*.*"] = "lua",
  },
}
